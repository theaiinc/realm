{
  "name": "@theaiinc/realm-core",
  "version": "0.3.0",
  "description": "Core abstractions, types, and API facade for the Realm platform — the universal interface for isolated AI execution environments",
  "keywords": [
    "realm",
    "ai",
    "agent",
    "sandbox",
    "isolation",
    "execution-environment"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaiinc/realm.git",
    "directory": "packages/realm-core"
  },
  "homepage": "https://github.com/theaiinc/realm/blob/main/packages/realm-core/README.md",
  "bugs": {
    "url": "https://github.com/theaiinc/realm/issues"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
