{
  "name": "@theaiinc/realm-client",
  "version": "0.1.0",
  "description": "Streaming and control client for Realm — guacamole-lite WebSocket proxy to guacd plus a thin REST wrapper around realm-api",
  "keywords": ["realm", "guacamole", "rdp", "streaming", "websocket"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts src/server.ts src/serve.ts --format esm --dts --clean",
    "serve": "node dist/serve.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@theaiinc/realm-core": "workspace:*",
    "guacamole-lite": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theaiinc/realm.git",
    "directory": "packages/realm-client"
  },
  "homepage": "https://github.com/theaiinc/realm/blob/main/packages/realm-client/README.md",
  "bugs": {
    "url": "https://github.com/theaiinc/realm/issues"
  }
}
