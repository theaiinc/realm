{
    "name": "@theaiinc/realm-cloudrun",
    "version": "0.1.0",
    "description": "Cloud Run Jobs execution engine for Realm",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "files": ["dist"],
    "scripts": {
      "build": "tsup src/index.ts --format esm --dts --clean",
      "test": "vitest run"
    },
    "dependencies": {
      "@google-cloud/run": "^1.0.0",
      "@google-cloud/storage": "^7.15.0",
      "@theaiinc/realm-core": "workspace:*",
      "google-auth-library": "^9.15.0"
    },
    "devDependencies": {
      "tsup": "^8.0.0",
      "typescript": "^5.3.0",
      "vitest": "^3.2.0"
    },
    "publishConfig": {
      "access": "public"
    }
  }